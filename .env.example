# Base URL of the LedgerCore API gateway (Traefik). When it is not reachable
# (or this variable is unset) the console falls back to demo data.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Servidor de la consola -> identity (sesiones, usuarios). Solo en el servidor;
# si falta, el proxy /api/identity usa NEXT_PUBLIC_API_URL (el gateway).
# LEDGERCORE_IDENTITY_URL=http://localhost:8082

# Secreto compartido con identity (mismo valor que su LEDGERCORE_CONSOLE_TOKEN).
# Hace falta cuando la consola no corre junto a identity (Vercel): con él la
# consola informa la IP del navegador para el bloqueo de login y el límite de
# tráfico del gateway. Solo en el servidor; nunca con prefijo NEXT_PUBLIC_.
# LEDGERCORE_CONSOLE_TOKEN=
